<UserControl x:Class="QuickLook.Plugin.PbpViewer.ViewerPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="ViewerPanel"
             Background="{DynamicResource MainWindowBackground}"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuickLook.Common;component/Styles/MainWindowStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BitmapImage x:Key="DefaultIcon" UriSource="images/default_icon.png"/>

            <Style x:Key="LabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource WindowTextForeground}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="0,4"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="ValueStyle" TargetType="TextBox">
                <Setter Property="Foreground" Value="{DynamicResource WindowTextForeground}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="Margin" Value="0,4"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="167"/>
            <ColumnDefinition Width="9"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Картинки слева -->
        <StackPanel Grid.Column="0" Orientation="Vertical">
            <Border Width="160" Height="100"  CornerRadius="6" Margin="0,0,0,8">
                <Image x:Name="imgIcon0" Source="{StaticResource DefaultIcon}" Stretch="Uniform" Margin="4"/>
            </Border>
            <TextBlock Text="ICON0" FontSize="11" Opacity="0.7" HorizontalAlignment="Center" Margin="0,0,0,10"
                       Foreground="{DynamicResource WindowTextForeground}"/>

            <Border x:Name="borderPic0" Width="160" Height="90" CornerRadius="6"
                    Margin="0,0,0,8" Visibility="Collapsed">
                <Image x:Name="imgPic0" Stretch="Uniform" Margin="4"/>
            </Border>
            <TextBlock x:Name="lblPic0" Text="PIC0" FontSize="11" Opacity="0.7" HorizontalAlignment="Center"
                       Margin="0,0,0,10" Visibility="Collapsed"
                       Foreground="{DynamicResource WindowTextForeground}"/>

            <Border x:Name="borderPic1" Width="160" Height="90" CornerRadius="6"
                    Margin="0,0,0,8" Visibility="Collapsed">
                <Image x:Name="imgPic1" Stretch="Uniform" Margin="4"/>
            </Border>
            <TextBlock x:Name="lblPic1" Text="PIC1" FontSize="11" Opacity="0.7" HorizontalAlignment="Center"
                       Visibility="Collapsed"
                       Foreground="{DynamicResource WindowTextForeground}"/>
            <Border x:Name="borderBoot"
                    Width="160"
                    Height="90"
                    
                    CornerRadius="6"
                    Margin="0,0,0,8"
                    Visibility="Collapsed">
                            <Image x:Name="imgBoot"
                       Stretch="Uniform"
                       Margin="4"/>
                        </Border>

                        <TextBlock x:Name="lblBoot"
                       Text="BOOT"
                       FontSize="11"
                       Opacity="0.7"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"
                       Visibility="Collapsed"
                       Foreground="{DynamicResource WindowTextForeground}"/>
        </StackPanel>

        <!-- Текст справа -->
        <Grid Grid.Column="2" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="lblTitle"    Grid.Row="0"  Grid.Column="0" Text="Title:"     Style="{StaticResource LabelStyle}" FontWeight="SemiBold"/>
            <TextBox   x:Name="tbTitle"     Grid.Row="0"  Grid.Column="1" Style="{StaticResource ValueStyle}"/>

            <TextBlock x:Name="lblTitleId"  Grid.Row="1"  Grid.Column="0" Text="Title ID:"  Style="{StaticResource LabelStyle}" FontWeight="SemiBold"/>
            <TextBox   x:Name="tbTitleId"   Grid.Row="1"  Grid.Column="1" Style="{StaticResource ValueStyle}"/>

            <TextBlock x:Name="lblAppVer"   Grid.Row="2"  Grid.Column="0" Text="APP_VER:"   Style="{StaticResource LabelStyle}" FontWeight="SemiBold"/>
            <TextBox   x:Name="tbAppVer"    Grid.Row="2"  Grid.Column="1" Style="{StaticResource ValueStyle}"/>

            <TextBlock x:Name="lblFirmware" Grid.Row="3"  Grid.Column="0" Text="Firmware:"  Style="{StaticResource LabelStyle}" FontWeight="SemiBold"/>
            <TextBox   x:Name="tbFirmware"  Grid.Row="3"  Grid.Column="1" Style="{StaticResource ValueStyle}"/>

            <TextBlock x:Name="lblCategory" Grid.Row="4"  Grid.Column="0" Text="Category:"  Style="{StaticResource LabelStyle}" FontWeight="SemiBold"/>
            <TextBox   x:Name="tbCategory"  Grid.Row="4"  Grid.Column="1" Style="{StaticResource ValueStyle}"/>

            <TextBlock x:Name="lblDiscId"   Grid.Row="5"  Grid.Column="0" Text="Disc ID:"   Style="{StaticResource LabelStyle}" FontWeight="SemiBold"/>
            <TextBox   x:Name="tbDiscId"    Grid.Row="5"  Grid.Column="1" Style="{StaticResource ValueStyle}"/>

            <TextBlock x:Name="lblDiscVer"  Grid.Row="6"  Grid.Column="0" Text="Disc Ver:"  Style="{StaticResource LabelStyle}" FontWeight="SemiBold"/>
            <TextBox   x:Name="tbDiscVer"   Grid.Row="6"  Grid.Column="1" Style="{StaticResource ValueStyle}"/>

            <TextBlock x:Name="lblParental" Grid.Row="7"  Grid.Column="0" Text="Parental:"  Style="{StaticResource LabelStyle}" FontWeight="SemiBold"/>
            <TextBox   x:Name="tbParental"  Grid.Row="7"  Grid.Column="1" Style="{StaticResource ValueStyle}"/>

            <TextBlock x:Name="lblRegion"   Grid.Row="8"  Grid.Column="0" Text="Region:"    Style="{StaticResource LabelStyle}" FontWeight="SemiBold"/>
            <TextBox   x:Name="tbRegion"    Grid.Row="8"  Grid.Column="1" Style="{StaticResource ValueStyle}"/>

            <TextBlock x:Name="lblBootable" Grid.Row="9"  Grid.Column="0" Text="Bootable:"  Style="{StaticResource LabelStyle}" FontWeight="SemiBold"/>
            <TextBox   x:Name="tbBootable"  Grid.Row="9"  Grid.Column="1" Style="{StaticResource ValueStyle}"/>

            <TextBlock x:Name="lblSize"     Grid.Row="10" Grid.Column="0" Text="File Size:" Style="{StaticResource LabelStyle}" FontWeight="SemiBold"/>
            <TextBox   x:Name="tbSize"      Grid.Row="10" Grid.Column="1" Style="{StaticResource ValueStyle}"/>

            <TextBlock x:Name="lblIcon1"    Grid.Row="11" Grid.Column="0" Text="ICON1.PMF:" Style="{StaticResource LabelStyle}" FontWeight="SemiBold"/>
            <TextBox   x:Name="tbIcon1"     Grid.Row="11" Grid.Column="1" Style="{StaticResource ValueStyle}"/>

            <TextBlock x:Name="lblSnd0"     Grid.Row="12" Grid.Column="0" Text="SND0.AT3:"  Style="{StaticResource LabelStyle}" FontWeight="SemiBold"/>
            <TextBox   x:Name="tbSnd0"      Grid.Row="12" Grid.Column="1" Style="{StaticResource ValueStyle}"/>

            <TextBlock x:Name="lblDemo"     Grid.Row="13" Grid.Column="0" Text="Demo/Homebrew:"      Style="{StaticResource LabelStyle}" FontWeight="SemiBold"/>
            <TextBox   x:Name="tbDemo"      Grid.Row="13" Grid.Column="1" Style="{StaticResource ValueStyle}"/>

            <TextBlock x:Name="lblFakeNp"   Grid.Row="14" Grid.Column="0" Text="FakeNP:"    Style="{StaticResource LabelStyle}" FontWeight="SemiBold"/>
            <TextBox   x:Name="tbFakeNp"    Grid.Row="14" Grid.Column="1" Style="{StaticResource ValueStyle}"/>
        </Grid>

        <!-- Тема + музыка -->
        <StackPanel Grid.Column="3" VerticalAlignment="Top" HorizontalAlignment="Center">
            <Image x:Name="btnSwTheme"
           Width="22" Height="22"
           Cursor="Hand"
           ToolTip="Switch theme">
                <Image.Style>
                    <Style TargetType="Image">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=ViewerPanel, Path=Theme}" Value="Light">
                                <Setter Property="Source">
                                    <Setter.Value>
                                        <BitmapImage UriSource="images/black_btn.png"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ElementName=ViewerPanel, Path=Theme}" Value="Dark">
                                <Setter Property="Source">
                                    <Setter.Value>
                                        <BitmapImage UriSource="images/white_btn.png"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>

            <!-- По умолчанию скрыта; показывается если есть SND0 -->
            <Image x:Name="btnPlaySnd0"
               Width="22"
               Height="22"
               Margin="0,12,0,0"
               Cursor="Hand"
               ToolTip="Play SND0 (loop)"
               HorizontalAlignment="Center"
               Stretch="Uniform"
               Source="images/snd_off.png"/>
        </StackPanel>
    </Grid>
</UserControl>